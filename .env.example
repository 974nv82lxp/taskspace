# TaskSpace environment configuration

# Application environment: development or production
NODE_ENV=development

# Local web server port
PORT=3000

# Required: use a unique random secret of at least 32 characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional: Finnhub API key for stock market data
FINNHUB_API_KEY=your-finnhub-api-key
